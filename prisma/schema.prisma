// Prisma Schema for VERIPRICE: National Supply Chain & Tax Ledger
// Phase 2: Core Database Models (User, Seller, Category, Product, ProductImage, ProductDocument, and National Ledger Entities)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  type          String   // GOVERNMENT, TAX_AUTHORITY, MANUFACTURER, IMPORTER, RETAILER_DISTRIBUTOR, AUDIT_FIRM, CONSUMER
  taxPin        String   @unique
  licenseNumber String   @unique
  jurisdiction  String
  verified      Boolean  @default(false)
  address       String
  contactEmail  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  users         User[]
  batches       BatchItem[]
  declarations  CustomsDeclaration[]
  inventory     BusinessInventoryItem[]
  soldInvoices  Invoice[]              @relation("SellerOrg")
  boughtInvoices Invoice[]             @relation("BuyerOrg")
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  passwordHash     String?
  role             String        // SUPER_ADMIN, TAX_OFFICER, MANUFACTURER, IMPORTER, BUSINESS_EMPLOYEE, AUDITOR, CONSUMER
  status           String        @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  orgId            String?
  organization     Organization? @relation(fields: [orgId], references: [id])
  employeeCode     String?
  designation      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  seller           Seller?
  issuedInvoices   Invoice[]
  assignedAlerts   FraudAlert[]
}

model Seller {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  registrationNumber String    @unique
  panVatNumber       String    @unique
  contactEmail       String
  contactPhone       String?
  address            String
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  verificationNotes  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  products           Product[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  products    Product[]
}

model Product {
  id                  String            @id @default(cuid())
  name                String
  description         String?
  brand               String?
  model               String?
  categoryId          String
  category            Category          @relation(fields: [categoryId], references: [id])
  sellerId            String?
  seller              Seller?           @relation(fields: [sellerId], references: [id])
  manufacturerName    String?
  countryOfOrigin     String            @default("Nepal")
  originType          String            @default("DOMESTIC_MANUFACTURED") // IMPORTED, DOMESTIC_MANUFACTURED
  isNepalManufactured Boolean           @default(true)
  isVatApplicable     Boolean           @default(true)
  vatRate             Float             @default(0.13)
  vatPaid             Float             @default(0.0)
  actualCost          Float
  consumerPrice       Float             // Statutory Maximum Retail Price (MRP)
  currency            String            @default("NPR")
  verificationStatus     String            @default("PENDING") // DRAFT, PENDING, SUBMITTED, UNDER_REVIEW, VERIFIED, REJECTED, CHANGES_REQUESTED
  verificationNotes      String?
  rejectionReason        String?
  verifiedAt             DateTime?
  approvedAt             DateTime?
  submittedAt            DateTime?
  submissionNotes        String?
  reviewerId             String?           // Government reviewer user ID
  reviewerName           String?           // Denormalized for fast display
  reviewerRole           String?           // Role at time of review assignment
  reviewStartedAt        DateTime?         // When review was taken / assigned
  changesRequestedAt     DateTime?         // Last time changes were requested
  changesRequestedNotes  String?           // Current outstanding change request (visible to seller)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt

  images              ProductImage[]
  documents           ProductDocument[]
  submissions         ProductSubmissionHistory[]
  history             ProductHistory[]
}

model ProductImage {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageReference String   // Relative path within uploads/public/images/<productId>/
  url              String   // Served public URL path e.g. /api/products/:id/images/:imageId/serve
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String
  altText          String?
  isPrimary        Boolean  @default(false)
  sortOrder        Int      @default(0)
  metadata         String?  // JSON metadata (dimensions, etc.)
  uploadedByUserId String
  createdAt        DateTime @default(now())
}

model ProductDocument {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  documentType     String   // LAB_CERTIFICATE, BILL_OF_ENTRY, TAX_CLEARANCE, INVOICE_COPY, MANUFACTURER_AUTHORIZATION, QUALITY_CERTIFICATE, IMPORT_LICENSE, VAT_REGISTRATION, FOOD_DRUG_APPROVAL, OTHER
  storageReference String   // Relative path within uploads/private/documents/<productId>/ — NEVER public
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String
  status           String   @default("PENDING_REVIEW") // PENDING_REVIEW, VERIFIED, REJECTED
  verifiedByUserId String?
  verifiedAt       DateTime?
  rejectionReason  String?
  uploadedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model ProductSubmissionHistory {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromStatus        String
  toStatus          String
  action            String   @default("STATUS_CHANGE") // SUBMITTED, REVIEW_STARTED, APPROVED, REJECTED, CHANGES_REQUESTED, RESUBMITTED
  submittedByUserId String
  submittedByName   String
  submittedByRole   String
  reviewerId        String?  // Set when action is a reviewer action
  submissionNotes   String?
  documentsCount    Int      @default(0)
  imagesCount       Int      @default(0)
  timestamp         DateTime @default(now())
}

model ProductHistory {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  changeType        String   // PRICE_CHANGE, SELLER_CHANGE, STATUS_CHANGE, ADMIN_OVERRIDE, FIELD_UPDATE, SPEC_UPDATE
  fieldName         String   // consumerPrice, actualCost, sellerId, verificationStatus, name, etc.
  oldValue          String?  // Previous value (e.g. "Rs. 2,500")
  newValue          String?  // New value (e.g. "Rs. 2,300")
  changedByUserId   String
  changedByName     String
  changedByRole     String
  reason            String?  // Explanation or administrative rationale
  metadata          String?  // JSON metadata (e.g. IP address, field metadata)
  createdAt         DateTime @default(now())
}


model BatchItem {
  id                String            @id @default(cuid())
  batchNumber       String            @unique
  productName       String
  category          String
  hsCode            String
  description       String?
  quantity          Int
  availableQuantity Int
  unit              String            @default("Units")
  productionDate    DateTime
  expiryDate        DateTime?
  manufacturerOrgId String
  manufacturer      Organization      @relation(fields: [manufacturerOrgId], references: [id])
  factoryLocation   String
  baseCost          Float
  standardVatRate   Float             @default(0.13)
  exciseRate        Float             @default(0.0)
  statutoryMrp      Float
  status            String            @default("PRODUCED")
  carbonFootprintKg Float             @default(1.2)
  provenanceHash    String
  serialPrefix      String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  passports         ProductPassport[]
}

model ProductPassport {
  id                  String                 @id @default(cuid())
  serialNumber        String                 @unique
  batchId             String
  batch               BatchItem              @relation(fields: [batchId], references: [id])
  batchNumber         String
  productName         String
  category            String
  hsCode              String
  manufacturerOrgId   String
  currentHolderOrgId  String
  statutoryMrp        Float
  status              String                 @default("PRODUCED")
  isAuthentic         Boolean                @default(true)
  isRecalled          Boolean                @default(false)
  scanCount           Int                    @default(0)
  lastScannedAt       DateTime?
  lastScannedLocation String?
  digitalSignature    String
  qrPayload           String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now()) @updatedAt

  journey             PassportJourneyEvent[]
}

model PassportJourneyEvent {
  id           String          @id @default(cuid())
  passportId   String
  passport     ProductPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  timestamp    DateTime        @default(now())
  stage        String          // MANUFACTURED, CUSTOMS_CLEARED, DISTRIBUTED, RETAIL_RECEIVED, POINT_OF_SALE, CONSUMER_VERIFIED, SUSPICIOUS_FLAG
  actorRole    String
  actorName    String
  actorOrgName String
  location     String
  details      String
  hash         String
  isVerified   Boolean         @default(true)
}

model CustomsDeclaration {
  id                   String       @id @default(cuid())
  consignmentId        String       @unique
  billOfEntryNo        String       @unique
  importerOrgId        String
  importer             Organization @relation(fields: [importerOrgId], references: [id])
  portOfOrigin         String
  portOfEntry          String
  arrivalDate          DateTime
  hsCode               String
  productSummary       String
  declaredValueUsd     Float
  declaredValueLocal   Float
  customsDutyRate      Float
  customsDutyAmount    Float
  importVatAmount      Float
  totalCustomsDutyPaid Float
  clearanceStatus      String       @default("PENDING_DUTY")
  officerNotes         String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now()) @updatedAt
}

model BusinessInventoryItem {
  id               String       @id @default(cuid())
  businessOrgId    String
  businessOrg      Organization @relation(fields: [businessOrgId], references: [id])
  batchId          String
  batchNumber      String
  productName      String
  category         String
  hsCode           String
  sku              String
  stockQuantity    Int
  unitCost         Float
  retailPrice      Float
  statutoryMrp     Float
  isPriceCompliant Boolean      @default(true)
  lastRestockedAt  DateTime     @default(now())
  supplierOrgName  String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
}

model Invoice {
  id                     String            @id @default(cuid())
  invoiceNumber          String            @unique
  irn                    String            @unique
  invoiceType            String            @default("B2C_RETAIL")
  sellerOrgId            String
  sellerOrg              Organization      @relation("SellerOrg", fields: [sellerOrgId], references: [id])
  sellerName             String
  sellerTaxPin           String
  sellerAddress          String
  buyerOrgId             String?
  buyerOrg               Organization?     @relation("BuyerOrg", fields: [buyerOrgId], references: [id])
  buyerName              String
  buyerTaxPin            String?
  buyerType              String            @default("INDIVIDUAL_CONSUMER")
  subtotal               Float
  totalDiscount          Float             @default(0)
  totalExcise            Float             @default(0)
  totalVat               Float             @default(0)
  grandTotal             Float
  paymentMethod          String            @default("CARD")
  fiscalStatus           String            @default("VALIDATED")
  issuedByUserId         String
  issuedByUser           User              @relation(fields: [issuedByUserId], references: [id])
  issuedByName           String
  qrCodeUrl              String
  fiscalStampHash        String
  isPriceGougingDetected Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt

  items                  InvoiceLineItem[]
}

model InvoiceLineItem {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serialNumber  String?
  batchId       String
  batchNumber   String
  productName   String
  hsCode        String
  quantity      Int
  unitPrice     Float
  mrp           Float
  discount      Float    @default(0)
  taxableAmount Float
  vatRate       Float    @default(0.13)
  vatAmount     Float
  exciseRate    Float    @default(0)
  exciseAmount  Float    @default(0)
  totalAmount   Float
}

model TaxRule {
  id                 String   @id @default(cuid())
  hsCode             String   @unique
  category           String
  description        String
  standardVatRate    Float    @default(0.13)
  exciseDutyRate     Float    @default(0)
  customsDutyRate    Float    @default(0)
  luxuryTaxRate      Float    @default(0)
  maxProfitMarginCap Float    @default(0.20)
  statutoryPriceCap  Float?
  updatedByRole      String
  updatedAt          DateTime @updatedAt
}

model FraudAlert {
  id                 String   @id @default(cuid())
  type               String   // DUPLICATE_SCAN, PRICE_GOUGING, UNREGISTERED_SERIAL, TAX_CAROUSEL_MISMATCH, SUSPICIOUS_VELOCITY, CONSUMER_WHISTLEBLOWER
  severity           String   @default("MEDIUM")
  title              String
  description        String
  targetSerialNumber String?
  targetBatchId      String?
  targetOrgId        String?
  targetOrgName      String?
  targetInvoiceId    String?
  riskScore          Int      @default(50)
  status             String   @default("OPEN")
  reportedBy         String
  assignedOfficerId  String?
  assignedOfficer    User?    @relation(fields: [assignedOfficerId], references: [id])
  actionNotes        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SystemAuditLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  userId        String
  userName      String
  userRole      String
  orgId         String
  orgName       String
  action        String   // USER_CREATED, USER_UPDATED, SELLER_REGISTERED, PRODUCT_CREATED, PRODUCT_EDITED, PRODUCT_SUBMITTED, PRODUCT_REVIEWED, PRODUCT_APPROVED, PRODUCT_REJECTED, CHANGES_REQUESTED, PRODUCT_RESUBMITTED, ADMIN_PRODUCT_CHANGED, ADMIN_SELLER_CHANGED, CATEGORY_CREATED, CATEGORY_MODIFIED, ADMIN_LOGIN, PERMISSION_CHANGED
  resourceType  String   // USER, SELLER, PRODUCT, CATEGORY, PERMISSION, AUTH, SYSTEM, INVOICE, BATCH
  resourceId    String
  previousValue String?
  newValue      String?
  ipAddress     String   @default("127.0.0.1")
  status        String   @default("SUCCESS")
  details       String
  metadata      String?
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

